function countDuplicates(arr) {
  let countMap = {};

  for (let num of arr) {
    countMap[num] = (countMap[num] || 0) + 1;
  }

  // Filter out numbers that appear only once
  let result = {};
  for (let key in countMap) {
    if (countMap[key] > 1) {
      result[Number(key)] = countMap[key]; // Convert key to a number
    }
  }

  return result;
}
// [1,1,1,2,2,3,3,4,4,4,5]
// {1:3, 2:2,  4:3}
console.log(countDuplicates([1, 1, 1, 2, 2, 3, 3, 4, 4, 4, 5]));

