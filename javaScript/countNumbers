function countingNumbers(arr) {
  let obj = {};

  for (let x of arr) {
    if (obj[x]) {
      obj[x] += 1;
    } else {
      obj[x] = 1;
    }
  }
  return obj;
}

console.log(countingNumbers([1, 1, 1, 2, 3, 4, 5, 5, 5, 6]));

