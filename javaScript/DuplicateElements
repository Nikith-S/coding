function findDuplicates(arr) {
  var visited = new Set();
  var duplicate = new Set();

  for (let num of arr) {
    if (visited.has(num)) {
      duplicate.add(num);
    } else {
      visited.add(num);
    }
  }
  return Array.from(duplicate);
}
